        <mxCell id="1y0eVGkfd-wTPIM0Y5jU-256" parent="1y0eVGkfd-wTPIM0Y5jU-267" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontFamily=Arial;align=center;verticalAlign=middle;gradientColor=#97d077;strokeWidth=2;shadow=1;textShadow=1;" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;كان رسول الله صلى الله عليه وسلم قد فزع عن الصلاة ثم طال ضعفه في حجته&lt;/font&gt;" vertex="1">
          <mxGeometry height="98.33333333333333" width="570" y="66.86666666666667" as="geometry" />
        </mxCell>
        <mxCell id="1y0eVGkfd-wTPIM0Y5jU-258" parent="1y0eVGkfd-wTPIM0Y5jU-267" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontFamily=Arial;align=center;verticalAlign=middle;gradientColor=#97d077;strokeWidth=2;shadow=1;textShadow=1;" value="&lt;font style=&quot;font-size: 30px;&quot;&gt;سألت النبي صلي الله عليه وسلم عن الرقاة فقال اسمع قولنا، فإنما هي رقة. لا تطل على الأرواح في الصلاة&lt;/font&gt;" vertex="1">
          <mxGeometry height="98.33333333333333" width="570" y="173.0666666666667" as="geometry" />
        </mxCell>
        <mxCell id="1y0eVGkfd-wTPIM0Y5jU-260" parent="1y0eVGkfd-wTPIM0Y5jU-267" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontFamily=Arial;align=center;verticalAlign=middle;gradientColor=#97d077;strokeWidth=2;shadow=1;textShadow=1;" value="&lt;font style=&quot;font-size: 31px;&quot;&gt;لا تقصر الصلاة إلا بما يرضي الله سبحانه وتعالى في ذلك منكم الذين آمنتم&lt;/font&gt;" vertex="1">
          <mxGeometry height="98.33333333333333" width="570" y="279.26666666666665" as="geometry" />
